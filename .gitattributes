# 统一行尾，避免 Windows 检出时把 LF 换成 CRLF
# 这会影响 GitHub Actions 里运行的脚本，必须固定。
* text=auto eol=lf

# 明确指定类型
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# 二进制文件不做行尾转换
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.blend binary
*.blend1 binary
*.psd   binary
*.tga   binary
*.exr   binary
*.dds   binary
